# 정적 자산의 캐시 수명.
#
# Static Assets 는 기본으로 `max-age=0, must-revalidate` 를 준다. 그래서 CSS·JS·
# 이미지가 방문마다 다시 확인된다. 런칭 첫날 요청이 127,793건이었고 무료 한도는
# 하루 100,000건이다 — 홈 한 번 여는 데 37건이 나가고 그중 30건이 정적 자산이다.
#
# 이 파일이 필요한 이유는, 정적 자산이 Worker 를 거치지 않기 때문이다.
# withSecurityHeaders 같은 코드로는 여기에 헤더를 붙일 수 없다.
#
# 파일 이름에 버전이 없어 immutable 은 못 준다. 대신 짧게 준다 — 한 사람의 한 번
# 방문 동안에는 다시 묻지 않고, 배포로 파일이 바뀌어도 5분 뒤엔 새것을 받는다.

/css/*
  Cache-Control: public, max-age=300

/js/*
  Cache-Control: public, max-age=300

# 로고와 아이콘은 거의 바뀌지 않는다. 바꿀 때는 파일명을 바꾼다.
/assets/*
  Cache-Control: public, max-age=86400

# HTML·서비스워커·매니페스트는 캐시하지 않는다. HTML 을 캐시하면 배포한 화면이
# 안 바뀌고, sw.js 를 캐시하면 새 버전 감지 자체가 늦어진다.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
