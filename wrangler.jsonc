{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yukjindae-map",
  "compatibility_date": "2024-09-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    // 다중 페이지 정적 사이트(index/map/place.html)라서 pokemon 프로젝트와 달리
    // "single-page-application" 폴백은 쓰지 않음 — 켜면 없는 경로가 항상 index.html로
    // 대체되어 존재하지 않는 페이지도 200으로 응답하게 됨
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "yukjindae-map-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "fb985d035ef04d20911f768fcf337d0e"
    }
  ],
  // 크론 다섯 개가 모두 같은 scheduled() 핸들러로 들어오므로, worker.js의
  // ENRICHMENT_CRON / FESTIVAL_IMPORT_CRON / STATION_GEOCODE_CRON /
  // PUBLIC_DATA_PLACE_MATCH_CRON / MONTHLY_TOP10_CRON 상수와 아래 표현식이
  // 항상 일치해야 한다. 하나만 바꾸면 그 작업이 조용히 안 돌게 된다.
  //
  // 주간 작업은 축제 수집 → 수유실 역명 지오코딩 → 장소·수유실 좌표 대조 순서로
  // 한 시간씩 띄웠다. 뒤 단계가 앞 단계의 최신 결과를 쓰기 때문에 순서가 중요하다.
  "triggers": {
    // 전부 KST 기준 일요일 새벽(UTC 토요일 오후)에 몰아 두었다. 사용자가 가장 적은
    // 시간대이고, 무거운 작업끼리 겹치지 않게 한 시간씩 띄웠다.
    // 월간 Top10은 KST 1일 00:00에 돌아야 하는데 UTC로는 전달 말일 15:00이라
    // 날짜를 못 박는다 — 말일 후보에 모두 걸고 코드에서 1일인지 확인한다.
    "crons": ["0 18 * * 6", "0 19 * * 6", "0 20 * * 6", "0 21 * * 6", "0 15 28-31 * *"]
  }
}
