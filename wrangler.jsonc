{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yukjindae-map",
  "compatibility_date": "2024-09-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    // 다중 페이지 정적 사이트(index/map/place.html)라서 pokemon 프로젝트와 달리
    // "single-page-application" 폴백은 쓰지 않음 — 켜면 없는 경로가 항상 index.html로
    // 대체되어 존재하지 않는 페이지도 200으로 응답하게 됨
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "yukjindae-map-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "fb985d035ef04d20911f768fcf337d0e"
    }
  ],
  // 매일 새벽 4시(KST, UTC+9)에 미확인 장소를 블로그 검색으로 보충 시도한다.
  // 매주 월요일에는 새벽 4시 TourAPI 축제 수집 → 5시 코레일/서울교통공사 수유실
  // 역명 지오코딩(좌표 없는 API라 KV에 미리 캐싱) → 6시 장소 좌표와 공공 수유실
  // 좌표를 대조해 "수유실" 체크박스 자동 보강 순으로 돈다(뒤 단계가 앞 단계의
  // 최신 결과를 써야 해서 순서가 중요함).
  //
  // 매월 1일 오전 9시(KST)에는 지역별 Top 10을 그 달 계절에 맞게 다시 매긴다.
  // 다른 크론처럼 새벽에 두려면 UTC로 "전달 말일 19시"여야 하는데 말일이 28~31일로
  // 달마다 달라 크론으로 못 쓴다 — 1일이 확실한 UTC 자정을 쓴다.
  //
  // 다섯 스케줄 모두 같은 scheduled() 핸들러가 받으므로 worker.js의
  // FESTIVAL_IMPORT_CRON/STATION_GEOCODE_CRON/PUBLIC_DATA_PLACE_MATCH_CRON/
  // MONTHLY_TOP10_CRON 상수와 아래 크론 표현식이 항상 일치해야 한다.
  "triggers": {
    "crons": ["0 19 * * *", "0 19 * * 1", "0 20 * * 1", "0 21 * * 1", "0 0 1 * *"]
  }
}
